# Demo database credentials (local dev only; do not use for production)
# Copy this file to .env and adjust values for your environment.
# docker-compose reads these as defaults; see docker-compose.yml for fallback values.

MYSQL_ROOT_PASSWORD=demo_root
MYSQL_DATABASE=demo_db
MYSQL_USER=demo_user
MYSQL_PASSWORD=demo_pass
DB_BIND=127.0.0.1
DB_PORT=3306
ADMINER_BIND=127.0.0.1
ADMINER_PORT=8080
